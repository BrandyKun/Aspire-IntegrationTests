<!--
  CustomerInterface = "the consumer".
    1. Reads RawNotification messages from its RabbitMQ queue.
    2. Transforms them into customer-friendly CustomerNotification rows.
    3. Saves them in Postgres (EF Core).
    4. Exposes GET /notifications so humans and tests can see what was stored.
-->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\AspireNotifications.ServiceDefaults\AspireNotifications.ServiceDefaults.csproj" />
    <ProjectReference Include="..\AspireNotifications.Contracts\AspireNotifications.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- RabbitMQ IConnection from the Aspire-injected connection string. -->
    <PackageReference Include="Aspire.RabbitMQ.Client" />
    <!-- EF Core + Npgsql, wired to the Aspire-injected Postgres connection string. -->
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

</Project>
